{
  "name": "shining-motion",
  "version": "0.3.0",
  "private": true,
  "description": "Object library for code-driven motion video: typed params, frame-number events, presets, meta.",
  "license": "MIT",
  "type": "module",
  "workspaces": ["packages/*", "examples/*"],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "meta": "tsx tools/build_meta.mjs",
    "gallery": "node gallery/build.mjs"
  },
  "devDependencies": {
    "@react-three/fiber": "9.8.1",
    "@remotion/bundler": "4.0.440",
    "@remotion/cli": "4.0.440",
    "@remotion/renderer": "4.0.440",
    "@remotion/three": "4.0.440",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/three": "0.186.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.440",
    "three": "0.186.1",
    "tsx": "4.21.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
