{
  "schema": 1,
  "objects": [
    {
      "name": "Dust",
      "route": "2d",
      "package": "2d",
      "export": "Dust",
      "summary": "A field of faint specks for dark backgrounds. Same seed, same field, on every render.",
      "params": [
        {
          "name": "w",
          "type": "number (px)",
          "note": "Field width."
        },
        {
          "name": "h",
          "type": "number (px)",
          "note": "Field height."
        },
        {
          "name": "n",
          "type": "number",
          "note": "Number of specks."
        },
        {
          "name": "seed",
          "type": "number",
          "default": 191
        },
        {
          "name": "rSpan",
          "type": "number",
          "default": 1.3,
          "note": "Radius is 0.6 + random x rSpan."
        },
        {
          "name": "op",
          "type": "[number, number]",
          "default": [
            0.06,
            0.18
          ],
          "note": "Opacity is op[0] + random x op[1]."
        },
        {
          "name": "colors",
          "type": "[string, string]",
          "default": [
            "#FFF7E9",
            "#6F80FF"
          ],
          "note": "Two speck colors, picked at random."
        },
        {
          "name": "f",
          "type": "number (current frame)",
          "note": "Pass the current frame to make the specks drift. Leave it out for a still field."
        }
      ],
      "events": [],
      "presets": {},
      "usedIn": [],
      "samples": [],
      "status": "stable"
    },
    {
      "name": "GrayLines",
      "route": "2d",
      "package": "2d",
      "export": "GrayLines",
      "summary": "Placeholder lines that say \"there is text here\" without asking anyone to read it. Percent widths, or unrolling pixel widths when w is given.",
      "params": [
        {
          "name": "n",
          "type": "number",
          "note": "Number of lines."
        },
        {
          "name": "h",
          "type": "number (px)",
          "default": 10,
          "note": "Line height."
        },
        {
          "name": "gap",
          "type": "number (px)",
          "default": 12,
          "note": "Space between lines. Default is 14 when w is given."
        },
        {
          "name": "color",
          "type": "string",
          "default": "#D9D9D9"
        },
        {
          "name": "seed",
          "type": "number",
          "default": 1,
          "note": "Percent mode only."
        },
        {
          "name": "min",
          "type": "number (%)",
          "default": 45,
          "note": "Percent mode only: minimum line width."
        },
        {
          "name": "w",
          "type": "number (px)",
          "note": "Switches to pixel mode: lines unroll from the left."
        },
        {
          "name": "prog",
          "type": "number (0..1)",
          "default": 1,
          "note": "Pixel mode only: unroll progress."
        }
      ],
      "events": [],
      "presets": {},
      "usedIn": [],
      "samples": [],
      "status": "stable"
    },
    {
      "name": "Seal",
      "route": "2d",
      "package": "2d",
      "export": "Seal",
      "summary": "A double-ruled stamp: lands oversized, settles in 9 frames, and leaves a ring of ink specks.",
      "params": [
        {
          "name": "text",
          "type": "string"
        },
        {
          "name": "at",
          "type": "number (frame)",
          "note": "Frame the stamp lands on."
        },
        {
          "name": "px",
          "type": "number (px)",
          "note": "Font size."
        },
        {
          "name": "color",
          "type": "string",
          "note": "Border, text and specks."
        },
        {
          "name": "rot",
          "type": "number (deg)",
          "default": -6
        },
        {
          "name": "pad",
          "type": "number (px)",
          "default": 14,
          "note": "Horizontal padding."
        },
        {
          "name": "bg",
          "type": "string",
          "default": "transparent"
        },
        {
          "name": "fontFamily",
          "type": "string",
          "default": "inherit"
        }
      ],
      "events": [
        "at"
      ],
      "presets": {},
      "usedIn": [],
      "samples": [],
      "status": "stable"
    }
  ]
}
